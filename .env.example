# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Enrollment, payment (Stripe) and student accounts all live in LearnWorlds;
# this site only links to the course there (COURSE_URL in lib/site.ts).
# The only secrets here are the two that let the site talk to n8n: one for the
# landing-page forms and one for the chat (see the sections below). They stay on
# the server: never give them a NEXT_PUBLIC_ name.

# --- Site -------------------------------------------------------------------
# Public address of the site, used for the canonical tag of every page.
# Optional: without it no canonical tag is written.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address shown on the /contact page. Without it the page shows no address.
CONTACT_EMAIL=

# --- Landing-page forms (/discover, /reinvent, /entrepreneurs, /creators, ---
# --- /campus, /discovery-pass) -----------------------------------------------
# Every valid form is handed to this n8n webhook, which stores it in the CRM
# (workflow: n8n/1-formularios-a-zoho-y-correos.json). Must be https.
N8N_LEADS_WEBHOOK_URL=
# Sent as the X-Webhook-Secret header, so n8n rejects anyone else. Use a long
# random value and put the same one in the n8n "Header Auth" credential.
N8N_LEADS_WEBHOOK_SECRET=
# Without BOTH values the forms answer "Registration is not open yet".

# --- Website chat (the "Ask us" button on the normal pages) -------------------
# Production URL of the n8n flow "4 · Chatbot: chat del sitio". Must be https.
N8N_CHAT_URL=
# The same value as the n8n Variable YB_CHAT_KEY (at least 16 characters).
N8N_CHAT_KEY=
# Without BOTH values the button still shows, but its window says the assistant is
# almost ready and links to the FAQ and the contact page. The site reads them when it is
# built, so after changing them it has to be redeployed (Railway does it itself).

# --- Search engines ---------------------------------------------------------
# "true" ONLY on the final public site. Anything else blocks indexing
# (robots.txt, the robots meta tag and the X-Robots-Tag header).
ROBOTS_ALLOW_INDEX=false

# --- Optional password gate for a staging copy ------------------------------
# Set BOTH to ask every visitor for this user and password. Leave them empty on
# the public site. Use a long random password: the site does not limit attempts.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASS=

# --- HTTPS ------------------------------------------------------------------
# In production, plain-http visits are sent to https. Set to "false" only if the
# host or Cloudflare already does that redirect.
FORCE_HTTPS=true
