# Copy this file to .env.local and fill in the values. Never commit .env.local.
# With NONE of these set, the site runs in a local DEMO mode (development only):
# the payment step is skipped so you can test the whole journey end to end.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional text shown under the pay button, e.g. "USD 499". The real amount is
# the Price you set in Stripe.
NEXT_PUBLIC_COURSE_PRICE_LABEL=

# --- Stripe (https://dashboard.stripe.com) ----------------------------------
STRIPE_SECRET_KEY=
# The Price ID of the course product (starts with price_)
STRIPE_PRICE_ID=
# "payment" (one-time, default) or "subscription" (recurring membership)
STRIPE_MODE=payment
# Signing secret of the webhook endpoint  <site>/api/stripe/webhook
# for the event checkout.session.completed (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# --- LearnWorlds ------------------------------------------------------------
LEARNWORLDS_SCHOOL_URL=https://your-school.learnworlds.com
LEARNWORLDS_CLIENT_ID=
LEARNWORLDS_API_TOKEN=
# ID of the course the buyer is enrolled in
LEARNWORLDS_COURSE_ID=
# Where students sign in / reset their password (defaults to the school URL)
LEARNWORLDS_LOGIN_URL=
LEARNWORLDS_RESET_URL=

# --- n8n (sends the emails) -------------------------------------------------
N8N_WEBHOOK_URL=
# Optional: sent as the X-Webhook-Secret header so n8n can reject other callers
N8N_WEBHOOK_SECRET=
