# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# This site holds NO secret keys. Enrollment, payment (Stripe) and student
# accounts all live in LearnWorlds; this site only links to the course there
# (COURSE_URL in lib/site.ts). Nothing below is a password for a paid service.

# --- Site -------------------------------------------------------------------
# Public address of the site, used for the canonical tag of every page.
# Optional: without it no canonical tag is written.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address shown on the /contact page. Without it the page shows no address.
CONTACT_EMAIL=

# --- Search engines ---------------------------------------------------------
# "true" ONLY on the final public site. Anything else blocks indexing
# (robots.txt, the robots meta tag and the X-Robots-Tag header).
ROBOTS_ALLOW_INDEX=false

# --- Optional password gate for a staging copy ------------------------------
# Set BOTH to ask every visitor for this user and password. Leave them empty on
# the public site. Use a long random password: the site does not limit attempts.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASS=

# --- HTTPS ------------------------------------------------------------------
# In production, plain-http visits are sent to https. Set to "false" only if the
# host or Cloudflare already does that redirect.
FORCE_HTTPS=true
